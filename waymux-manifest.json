{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "waymux",
  "version": "0.2.2",
  "description": "Autonomous Terminal AI Cockpit, Orchestrator CLI & JSON-RPC Control Plane Daemon",
  "engines": {
    "waymux": {
      "repo": "felipecm-br/waymux",
      "version": "v0.2.2",
      "binary": "waymux",
      "targets": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    },
    "waymaker": {
      "repo": "felipecm-br/waymaker",
      "version": "v0.3.2",
      "binary": "wm",
      "targets": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    },
    "lazygitrs": {
      "repo": "felipecm-br/lazygitrs",
      "version": "v0.1.3-cockpit",
      "binary": "lazygitrs",
      "targets": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  }
}
