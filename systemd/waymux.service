[Unit]
Description=Waymux: Terminal AI Cockpit & Agent Control Plane Daemon
Documentation=https://github.com/felipecm-br/waymux

[Service]
Type=notify
ExecStart=%h/.local/bin/waymux daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# The daemon pings every 15s while its state is responsive; a hang is restarted.
WatchdogSec=30s

# Security hardening. User units cannot count on mount namespaces (ProtectSystem=,
# ProtectHome=, PrivateTmp=, ProtectKernel*=): they need unprivileged user namespaces, which
# some distributions restrict, and the daemon must reach the tmux socket, the session bus,
# PipeWire and wherever flow_log_hook writes. These seccomp limits need only NoNewPrivileges=,
# and every child (tmux, sound players, the flow hook) inherits them. No
# MemoryDenyWriteExecute=: a flow_log_hook written for a JIT runtime would break.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# Resource limits
LimitNOFILE=65536
MemoryMax=512M

# Runtime directory for PID file, presets, and tokens
RuntimeDirectory=waymux

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=waymux

[Install]
WantedBy=default.target
Alias=acpd.service
