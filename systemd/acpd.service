[Unit]
Description=ACPD: Agent Client Protocol Daemon (waymux broker)
Documentation=https://github.com/fcmiranda/waymux
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/bin/acpd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

# Security hardening
NoNewPrivileges=yes
LimitNOFILE=65536
MemoryMax=512M

# Runtime directory for PID file and sockets
RuntimeDirectory=acpd

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acpd

[Install]
WantedBy=default.target
